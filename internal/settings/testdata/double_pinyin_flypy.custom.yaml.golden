# Generated by 拾新 from settings.json. Don't edit: changes are overwritten.
# Use the settings app instead.
patch:
  engine/processors:
    - shixin_rerank_processor
    - ascii_composer
    - recognizer
    - shixin_select_character
    - key_binder
    - speller
    - punctuator
    - selector
    - navigator
    - express_editor
  engine/segmentors:
    - ascii_segmentor
    - matcher
    - abc_segmentor
    - affix_segmentor@radical_lookup
    - punct_segmentor
    - fallback_segmentor
  engine/translators:
    - punct_translator
    - script_translator
    - shixin_date_translator
    - table_translator@custom_phrase
    - table_translator@radical_lookup
    - shixin_unicode_translator
    - shixin_number_translator
    - shixin_calc_translator
  engine/filters:
    - shixin_rerank
    - shixin_long_word_filter
    - shixin_english_demote_filter
    - shixin_v_filter
    - shixin_autocap_filter
    - reverse_lookup_filter@radical_reverse_lookup
    - simplifier@emoji
    - simplifier@traditionalize
    - uniquifier
    - shixin_pin_filter
  shixin_filters/long_word: true
  shixin_filters/demote_english: true
  shixin_filters/v_symbols: false
  shixin_filters/autocap: true
  shixin_filters/pins: []
  emoji/excluded_types:
    - date
    - number
    - unicode
    - calc
  translator/spelling_hints: 0
  translator/always_show_comments: false
  translator/comment_format: []
  switches:
    - {name: ascii_mode, states: [中, Ａ], reset: 1}
    - {name: ascii_punct, states: [¥, $], reset: 1}
    - {name: traditionalization, states: [简, 繁], reset: 1}
    - {name: emoji, states: [💀, 😄], reset: 1}
    - {name: full_shape, states: [半角, 全角], reset: 0}
  key_binder:
    select_first_character: minus
    select_last_character: equal
    bindings:
      - {when: composing, accept: Shift+Tab, send: Shift+Left}
      - {when: composing, accept: Tab, send: Shift+Right}
      - {when: composing, accept: Alt+Left, send: Shift+Left}
      - {when: composing, accept: Alt+Right, send: Shift+Right}
      - {when: has_menu, accept: comma, send: Page_Up}
      - {when: has_menu, accept: period, send: Page_Down}
      - {when: has_menu, accept: bracketleft, send: Page_Up}
      - {when: has_menu, accept: bracketright, send: Page_Down}
      - {when: has_menu, accept: Control+semicolon, send: Control+2}
      - {when: has_menu, accept: Control+apostrophe, send: Control+3}
      - {when: always, accept: Control+period, toggle: ascii_punct}
      - {when: always, accept: Control+Shift+4, toggle: traditionalization}
      - {when: always, accept: Control+Shift+dollar, toggle: traditionalization}
      - {when: always, accept: Control+comma, toggle: full_shape}
      - {when: composing, accept: KP_0, send: 0}
      - {when: composing, accept: KP_1, send: 1}
      - {when: composing, accept: KP_2, send: 2}
      - {when: composing, accept: KP_3, send: 3}
      - {when: composing, accept: KP_4, send: 4}
      - {when: composing, accept: KP_5, send: 5}
      - {when: composing, accept: KP_6, send: 6}
      - {when: composing, accept: KP_7, send: 7}
      - {when: composing, accept: KP_8, send: 8}
      - {when: composing, accept: KP_9, send: 9}
  editor/bindings:
    Control+Delete: noop
    Shift+Delete: delete
    Control+Shift+BackSpace: delete_candidate
  custom_phrase/user_dict: shixin_phrases
  speller/algebra/+:
    - xlit/ABCDEFGHIJKLMNOPQRSTUVWXYZ/abcdefghijklmnopqrstuvwxyz/
  speller/algebra/@before 000: derive/^zh/z/
  speller/algebra/@before 001: 'derive/^z([^h])/zh$1/'
  speller/algebra/@before 002: 'derive/([^iu])an$/$1ang/'
  speller/algebra/@before 003: 'derive/([^iu])ang$/$1an/'
  speller/algebra/@before 004: derive/^an$/ang/
  speller/algebra/@before 005: derive/^ang$/an/
  speller/algebra/@before 006: 'derive/^(?!xx$)([a-z]+)$/\U$1/'
  speller/algebra/@before 007: 'derive/^([NL])VE$/$1UE/'
  speller/algebra/@before 008: 'derive/^([JQXY])U/$1V/'
  speller/algebra/@before 009: 'derive/^([NL])UE$/$1VE/'
  speller/algebra/@before 010: 'derive/^([JQXY])V/$1U/'
