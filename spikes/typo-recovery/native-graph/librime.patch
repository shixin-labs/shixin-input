+bool Table::PrepareSpikeInitialCache(const string& sidecar_path) {
+  if(spike_initial_cache_) return true;
+  if(!IsOpen() || !index_) return false;
+  auto prepared=std::make_unique<SpikeInitialCache>();
+  path source=sidecar_path.empty()?path(file_path().u8string()+".initial3"):path(sidecar_path);
+  const shixin_spike::BoundIdentity identity{dict_file_checksum(),index_->size,metadata_->num_entries,file_size()};
+  prepared->initials.resize(index_->size);
+  for(size_t a=0;a<index_->size;++a) {
+    auto spelling=GetSyllableById(a);
+    prepared->initials[a]=spelling.empty()?0:spelling[0];
+  }
+  if(!shixin_spike::LoadInitialCache(source,identity,prepared->initials,&prepared->cache)) return false;
+  spike_initial_cache_=std::move(prepared);return true;
+}
+
+bool Table::PrepareSpikeMirrorCache(const string& mirror_path) {
+  if (!spike_initial_cache_) return false;
+  if (spike_initial_cache_->mirror_initialized)
+    return spike_initial_cache_->mirror_path == mirror_path && !spike_initial_cache_->mirror.native.empty();
+  spike_initial_cache_->mirror_required = true;
+  spike_initial_cache_->mirror_initialized = true;
+  spike_initial_cache_->mirror_path = mirror_path;
+  const shixin_spike::BoundIdentity identity{dict_file_checksum(), index_->size, metadata_->num_entries, file_size()};
+  return shixin_spike::LoadMirror(path(mirror_path), identity,
+      spike_initial_cache_->cache, &spike_initial_cache_->mirror);
+}
