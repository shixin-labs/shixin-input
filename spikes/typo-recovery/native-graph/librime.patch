+bool Context::ConfigureSpikeCorrections(uint64_t generation) {
+  if (!generation || !spike_incarnation_ || spike_revision_ == std::numeric_limits<uint64_t>::max()) return false;
+  if (!spike_registry_) spike_registry_.reset(new shixin_spike::CorrectionRegistry);
+  if (generation != spike_generation_) {
+    spike_generation_ = generation;
+    InvalidateSpikeCorrections();
+  }
