+bool Context::PublishSpikeCorrections() {
+  if (!spike_registry_ || !spike_generation_ || !spike_revision_ ||
+      spike_revision_ == std::numeric_limits<uint64_t>::max() || composition_.empty()) return false;
+  auto snapshot = As<SpikeCorrectionFilterTranslation>(composition_.back().spike_corrections);
+  if (!snapshot) return false;
+  std::array<shixin_spike::CorrectionChoice, 8> choices;
+  const auto count = snapshot->candidate_count();
+  if (count > choices.size()) return false;
+  for (size_t i=0; i<count; ++i)
+    if (!shixin_spike::ChoiceFromNativeTrace(*this, snapshot->candidate_at(i), &choices[i])) {
+      spike_registry_->Clear(); return false;
+    }
+  if (!spike_registry_->Publish(*this, {spike_generation_, spike_incarnation_, spike_revision_}, choices.data(), count)) return false;
+  spike_registry_->Seal();
+  return true;
+}
