+bool Table::PrepareSpikeCanonicalTable(const string& file) {
+  if (spike_canonical_initialized_)
+    return file == spike_canonical_path_ && bool(spike_canonical_table_);
+  spike_canonical_initialized_ = true;
+  spike_canonical_path_ = file;
+  the<Table> prepared(new Table(path(file)));
+  if (!prepared->Load() || !metadata_ ||
+      prepared->metadata()->num_syllables != metadata_->num_syllables)
+    return false;
+  for (size_t i = 0; i < metadata_->num_syllables; ++i)
+    if (prepared->GetSyllableById(i) != GetSyllableById(i))
+      return false;
+  if (!prepared->WarmSpikePages()) return false;
+  spike_canonical_table_ = std::move(prepared);
+  return true;
+}
